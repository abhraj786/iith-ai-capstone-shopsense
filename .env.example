# Copy this file to .env, then add the real keys for your environment.
# Settings are loaded by src/capstone/settings.py. Never commit real secrets.
CAPSTONE_DOMAIN=shopsense
CAPSTONE_LLM_MODEL=gemini/gemini-flash-lite-latest

# Example provider key names used by LiteLLM. Leave blank here; put real values in .env only.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: set these to use Qdrant Cloud like the course Colab.
# If left blank, the app uses local persistent Qdrant under runtime/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shopsense_policy_m3

# Required for strict external-cloud demo_milestones.py --real.
# Standard Langfuse names are supported, and CAPSTONE_ aliases are kept for this app.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
CAPSTONE_LANGFUSE_PUBLIC_KEY=
CAPSTONE_LANGFUSE_SECRET_KEY=
CAPSTONE_LANGFUSE_HOST=https://cloud.langfuse.com

# Optional reliability tuning for M7 tool calls.
CAPSTONE_TOOL_RETRY_ATTEMPTS=2
CAPSTONE_TOOL_CIRCUIT_FAILURE_THRESHOLD=2
CAPSTONE_TOOL_CIRCUIT_COOLDOWN_S=30

# The DATA TOOLKIT uses its own .env beside its generate.py; see its README.
