# Copy to .env; then add only the variables required by your local model provider.
# Settings are loaded by src/capstone/settings.py. Never commit real secrets.
CAPSTONE_DOMAIN=shopsense
CAPSTONE_LLM_MODEL=gemini/gemini-flash-lite-latest
# Example provider key name used by LiteLLM. Leave blank here; put the real value in .env only.
GEMINI_API_KEY=
# Optional: set these to use Qdrant Cloud like the course Colab.
# If left blank, the app uses local persistent Qdrant under runtime/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shopsense_policy_m3
# The DATA TOOLKIT uses its own .env beside its generate.py; see its README.
